   // Down arrow (left of the box) and up arrow (right of the box)
   CreateLotArrow(NM_LOTDN, ShortToString(0x25BC),  48, "Decrease lot size");
   CreateLotArrow(NM_LOTUP, ShortToString(0x25B2), 144, "Increase lot size");
}

// Small square arrow button in the bottom-left corner area
void CreateLotArrow(const string name, const string glyph, const int x, const string tip)
{
   ObjectCreate(0, name, OBJ_BUTTON, 0, 0, 0);
   ObjectSetInteger(0, name, OBJPROP_CORNER,      CORNER_LEFT_LOWER);
   ObjectSetInteger(0, name, OBJPROP_XDISTANCE,   x);
   ObjectSetInteger(0, name, OBJPROP_YDISTANCE,   30);
   ObjectSetInteger(0, name, OBJPROP_XSIZE,       30);
   ObjectSetInteger(0, name, OBJPROP_YSIZE,       30);
   ObjectSetInteger(0, name, OBJPROP_BGCOLOR,     ButtonBgColor);
   ObjectSetInteger(0, name, OBJPROP_COLOR,       ButtonIconColor);
   ObjectSetInteger(0, name, OBJPROP_BORDER_COLOR,ButtonBorder);
   ObjectSetInteger(0, name, OBJPROP_FONTSIZE,    8);
   ObjectSetString (0, name, OBJPROP_FONT,        "Arial");
   ObjectSetString (0, name, OBJPROP_TEXT,        glyph);
   ObjectSetString (0, name, OBJPROP_TOOLTIP,     tip);
   ObjectSetInteger(0, name, OBJPROP_SELECTABLE,  false);
   ObjectSetInteger(0, name, OBJPROP_HIDDEN,      true);
   ObjectSetInteger(0, name, OBJPROP_ZORDER,      10);
   ObjectSetInteger(0, name, OBJPROP_STATE,       false);
}

// Arrow click: change the lot size by one step (dir = +1 up, -1 down)
void StepLot(const int dir)
{
   double bstep = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
   if(bstep <= 0.0) bstep = 0.01;
   const double step = MathMax(LotStepButton, bstep);

   double target = g_lot + dir * step;
   target = MathRound(target / bstep) * bstep;          // avoid float drift (0.07 + 0.01)
   const double newLot = NormalizeVolume(target);      // clamp to broker min / max

   if(MathAbs(newLot - g_lot) < 1e-8)
      ShowStatus(dir > 0 ? "Maximum lot size reached" : "Minimum lot size reached", clrOrange);
   else
   {
      g_lot = newLot;
      GlobalVariableSet(LotKey(), g_lot);
   }
   ObjectSetString(0, NM_LOTBOX, OBJPROP_TEXT, DoubleToString(g_lot, LotDigits()));
   ChartRedraw();
}

// Number of decimals needed to display the broker's volume step
int LotDigits()
{
   double step = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
   if(step <= 0.0) step = 0.01;
   return (int)MathMax(0.0, MathRound(-MathLog10(step)));
}

// User typed a new lot size and pressed Enter
void HandleLotEdit()
{
   string txt = ObjectGetString(0, NM_LOTBOX, OBJPROP_TEXT);
   StringReplace(txt, ",", ".");                       // accept 0,10 as well as 0.10
   const double typed = StringToDouble(txt);

   if(typed <= 0.0)
   {
      ShowStatus("Invalid lot size - keeping " + DoubleToString(g_lot, LotDigits()), clrOrange);
   }
   else
   {
      g_lot = NormalizeVolume(typed);                  // clamp to broker min/max/step
      GlobalVariableSet(LotKey(), g_lot);
      if(MathAbs(g_lot - typed) > 1e-8)
         ShowStatus("Lot size adjusted to " + DoubleToString(g_lot, LotDigits()) + " (broker limits)", clrOrange);
   }
   ObjectSetString(0, NM_LOTBOX, OBJPROP_TEXT, DoubleToString(g_lot, LotDigits()));
   ChartRedraw();
}

// True if the point (x, y) lies inside the named object's rectangle
bool PointInObject(const string name, const int x, const int y)
{
   if(ObjectFind(0, name) < 0) return false;
   const int ox = (int)ObjectGetInteger(0, name, OBJPROP_XDISTANCE);
   const int oy = (int)ObjectGetInteger(0, name, OBJPROP_YDISTANCE);
   const int ow = (int)ObjectGetInteger(0, name, OBJPROP_XSIZE);
   const int oh = (int)ObjectGetInteger(0, name, OBJPROP_YSIZE);
   return (x >= ox && x <= ox + ow && y >= oy && y <= oy + oh);
}

// Click on the chart: dismiss the menu, but ignore clicks that belong to our
// own buttons (MT5 may raise CHARTEVENT_CLICK in addition to the object click,
// which would otherwise close the menu the instant it opens).
void HandleChartClick(const int x, const int y)
{
   if(!g_menuOpen) return;
   if(GetTickCount() - g_menuTick < 300) return;       // just opened: ignore
   if(PointInObject(NM_PLUS,  x, y) ||
      PointInObject(NM_MENU0, x, y) ||
      PointInObject(NM_MENU1, x, y))
      return;
   CloseMenu();
}

// Snap a price to the symbol's tick size
double NormalizePrice(const double price)
{
   double tick = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_SIZE);
   if(tick <= 0.0) tick = _Point;
   return NormalizeDouble(MathRound(price / tick) * tick, _Digits);
}

// Clamp lots to broker min/max and round down to the volume step
double NormalizeVolume(double lots)
{
   double step = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
   const double vmin = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
   const double vmax = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MAX);
   if(step <= 0.0) step = 0.01;

   lots = MathFloor(lots / step + 1e-8) * step;
   lots = MathMax(vmin, MathMin(vmax, lots));
   const int volDigits = (int)MathMax(0.0, MathRound(-MathLog10(step)));
   return NormalizeDouble(lots, volDigits);
}

string OrderTypeName(const ENUM_ORDER_TYPE t)
{
   switch(t)
   {
      case ORDER_TYPE_BUY_STOP:   return "Buy Stop";
      case ORDER_TYPE_BUY_LIMIT:  return "Buy Limit";
      case ORDER_TYPE_SELL_STOP:  return "Sell Stop";
      case ORDER_TYPE_SELL_LIMIT: return "Sell Limit";
   }
   return "Order";
}
