{
   ObjectCreate(0, NM_LOTLBL, OBJ_LABEL, 0, 0, 0);
   ObjectSetInteger(0, NM_LOTLBL, OBJPROP_CORNER,     CORNER_LEFT_LOWER);
   ObjectSetInteger(0, NM_LOTLBL, OBJPROP_ANCHOR,     ANCHOR_LEFT_LOWER);
   ObjectSetInteger(0, NM_LOTLBL, OBJPROP_XDISTANCE,  12);
   ObjectSetInteger(0, NM_LOTLBL, OBJPROP_YDISTANCE,  14);
   ObjectSetInteger(0, NM_LOTLBL, OBJPROP_COLOR,      LineColor);
   ObjectSetInteger(0, NM_LOTLBL, OBJPROP_FONTSIZE,   9);
   ObjectSetString (0, NM_LOTLBL, OBJPROP_FONT,       "Arial");
   ObjectSetString (0, NM_LOTLBL, OBJPROP_TEXT,       "Lots:");
   ObjectSetInteger(0, NM_LOTLBL, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, NM_LOTLBL, OBJPROP_HIDDEN,     true);

   ObjectCreate(0, NM_LOTBOX, OBJ_EDIT, 0, 0, 0);
   ObjectSetInteger(0, NM_LOTBOX, OBJPROP_CORNER,      CORNER_LEFT_LOWER);
   ObjectSetInteger(0, NM_LOTBOX, OBJPROP_XDISTANCE,   72);
   ObjectSetInteger(0, NM_LOTBOX, OBJPROP_YDISTANCE,   30);
   ObjectSetInteger(0, NM_LOTBOX, OBJPROP_XSIZE,       70);
   ObjectSetInteger(0, NM_LOTBOX, OBJPROP_YSIZE,       30);
   ObjectSetInteger(0, NM_LOTBOX, OBJPROP_BGCOLOR,     ButtonBgColor);
   ObjectSetInteger(0, NM_LOTBOX, OBJPROP_COLOR,       ButtonIconColor);
   ObjectSetInteger(0, NM_LOTBOX, OBJPROP_BORDER_COLOR,ButtonBorder);
   ObjectSetInteger(0, NM_LOTBOX, OBJPROP_FONTSIZE,    10);
   ObjectSetString (0, NM_LOTBOX, OBJPROP_FONT,        "Arial");
   ObjectSetInteger(0, NM_LOTBOX, OBJPROP_ALIGN,       ALIGN_CENTER);
   ObjectSetInteger(0, NM_LOTBOX, OBJPROP_READONLY,    false);
   ObjectSetInteger(0, NM_LOTBOX, OBJPROP_SELECTABLE,  false);
   ObjectSetInteger(0, NM_LOTBOX, OBJPROP_HIDDEN,      true);
   ObjectSetString (0, NM_LOTBOX, OBJPROP_TOOLTIP,     "Lot size for quick orders (type a value, press Enter)");
