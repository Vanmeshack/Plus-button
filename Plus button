// Create (once) and update a styled button
void EnsureButton(const string name, const string text,
                  const int x, const int y, const int w, const int h,
                  const color bg, const color fg, const color border,
                  const int fontSize, const string tooltip)
{
   if(ObjectFind(0, name) < 0)
   {
      ObjectCreate(0, name, OBJ_BUTTON, 0, 0, 0);
      ObjectSetInteger(0, name, OBJPROP_CORNER,     CORNER_LEFT_UPPER);
      ObjectSetInteger(0, name, OBJPROP_SELECTABLE, false);
      ObjectSetInteger(0, name, OBJPROP_SELECTED,   false);
      ObjectSetInteger(0, name, OBJPROP_HIDDEN,     true);
      ObjectSetInteger(0, name, OBJPROP_ZORDER,     10);   // above lines/labels
      ObjectSetString (0, name, OBJPROP_FONT,       "Arial Bold");
   }
   ObjectSetInteger(0, name, OBJPROP_XDISTANCE,   x);
   ObjectSetInteger(0, name, OBJPROP_YDISTANCE,   y);
   ObjectSetInteger(0, name, OBJPROP_XSIZE,       w);
   ObjectSetInteger(0, name, OBJPROP_YSIZE,       h);
   ObjectSetInteger(0, name, OBJPROP_BGCOLOR,     bg);
   ObjectSetInteger(0, name, OBJPROP_COLOR,       fg);
   ObjectSetInteger(0, name, OBJPROP_BORDER_COLOR,border);
   ObjectSetInteger(0, name, OBJPROP_FONTSIZE,    fontSize);
   ObjectSetInteger(0, name, OBJPROP_STATE,       false);
   ObjectSetString (0, name, OBJPROP_TEXT,        text);
   ObjectSetString (0, name, OBJPROP_TOOLTIP,     tooltip);
}

// Short-lived message in the top-left corner of the chart
void ShowStatus(const string text, const color clr)
{
   if(ObjectFind(0, NM_STATUS) < 0)
   {
      ObjectCreate(0, NM_STATUS, OBJ_LABEL, 0, 0, 0);
      ObjectSetInteger(0, NM_STATUS, OBJPROP_CORNER,     CORNER_LEFT_UPPER);
      ObjectSetInteger(0, NM_STATUS, OBJPROP_ANCHOR,     ANCHOR_LEFT_UPPER);
      ObjectSetInteger(0, NM_STATUS, OBJPROP_XDISTANCE,  12);
      ObjectSetInteger(0, NM_STATUS, OBJPROP_YDISTANCE,  24);
      ObjectSetInteger(0, NM_STATUS, OBJPROP_FONTSIZE,   10);
      ObjectSetString (0, NM_STATUS, OBJPROP_FONT,       "Arial");
      ObjectSetInteger(0, NM_STATUS, OBJPROP_SELECTABLE, false);
      ObjectSetInteger(0, NM_STATUS, OBJPROP_HIDDEN,     true);
   }
   ObjectSetString (0, NM_STATUS, OBJPROP_TEXT,  text);
   ObjectSetInteger(0, NM_STATUS, OBJPROP_COLOR, clr);
   g_statusExpire = TimeLocal() + 5;
   ChartRedraw();
}

// Key used to remember the lot size per symbol between EA reloads
string LotKey() { return "TVQO_Lot_" + _Symbol; }

// Small "Lots" label + edit box in the bottom-left corner of the chart
